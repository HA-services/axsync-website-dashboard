<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dashboard_index" name="Dashboards">
        <t t-call="website.layout">
            <div id="wrap" class="o_axs_dashboard_index">
                <div class="container py-4 py-lg-5">
                    <h1 class="h2 mb-1">Dashboards</h1>
                    <p class="text-muted mb-4">Live figures, always up to date.</p>
                    <div t-if="not dashboards" class="o_axs_empty text-center py-5">
                        <p class="lead mb-1">No dashboard is available for you yet.</p>
                        <p t-if="request.env.user._is_public()" class="text-muted">
                            <a href="/web/login?redirect=/dashboards">Sign in</a> to see the dashboards shared with you.
                        </p>
                    </div>
                    <div class="row g-3">
                        <div t-foreach="dashboards" t-as="dashboard" class="col-md-6 col-lg-4">
                            <a t-att-href="dashboard.website_url"
                               t-attf-class="o_axs_index_card d-block h-100 text-decoration-none text-reset o_axs_theme_#{dashboard.theme}">
                                <span class="o_axs_index_band"/>
                                <span class="d-block p-3">
                                    <span class="d-block h5 mb-1" t-field="dashboard.name"/>
                                    <span class="d-block text-muted small" t-field="dashboard.description"/>
                                    <span class="d-block small mt-3"><t t-esc="len(dashboard.item_ids)"/> items</span>
                                </span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="oe_structure" id="oe_structure_axs_dashboard_index"/>
            </div>
        </t>
    </template>

    <template id="dashboard_page" name="Dashboard">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="dashboard.name"/>
            <div id="wrap" class="o_axs_dashboard_page">
                <div class="oe_structure" id="oe_structure_axs_dashboard_top"/>
                <div class="container-fluid px-lg-4 py-3">
                    <div class="o_axs_dashboard_mount" t-att-data-axs-dashboard="dashboard.id" data-axs-page="1">
                        <div class="o_axs_loading text-center text-muted py-5">Loading dashboard</div>
                    </div>
                </div>
                <div class="oe_structure" id="oe_structure_axs_dashboard_bottom"/>
            </div>
        </t>
    </template>

    <template id="portal_my_home_dashboards" name="Dashboards in My Account" inherit_id="portal.portal_my_home"
              customize_show="True" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/axs_website_dashboard/static/src/img/portal_dashboard.svg'"/>
                <t t-set="title">Dashboards</t>
                <t t-set="text">Live figures shared with you</t>
                <t t-set="url" t-value="'/dashboards'"/>
                <t t-set="placeholder_count" t-value="'axs_dashboard_count'"/>
            </t>
        </xpath>
    </template>
</odoo>
