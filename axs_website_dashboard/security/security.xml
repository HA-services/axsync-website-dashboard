<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dashboard" model="ir.module.category">
        <field name="name">Website Dashboard</field>
        <field name="sequence">40</field>
    </record>

    <record id="privilege_dashboard" model="res.groups.privilege">
        <field name="name">Website Dashboard</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_dashboard"/>
    </record>

    <record id="group_dashboard_user" model="res.groups">
        <field name="name">Dashboard User</field>
        <field name="privilege_id" ref="privilege_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Opens the dashboards allowed to their groups in the back end.</field>
    </record>

    <record id="group_dashboard_manager" model="res.groups">
        <field name="name">Dashboard Manager</field>
        <field name="privilege_id" ref="privilege_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Creates, designs and publishes dashboards.</field>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_dashboard_user'))]"/>
    </record>

    <record id="rule_dashboard_company" model="ir.rule">
        <field name="name">Dashboards: multi-company</field>
        <field name="model_id" ref="model_axs_dashboard"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_dashboard_user_groups" model="ir.rule">
        <field name="name">Dashboards: back-end access groups</field>
        <field name="model_id" ref="model_axs_dashboard"/>
        <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_user'))]"/>
    </record>

    <record id="rule_dashboard_manager_all" model="ir.rule">
        <field name="name">Dashboards: managers see all</field>
        <field name="model_id" ref="model_axs_dashboard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_manager'))]"/>
    </record>

    <record id="rule_dashboard_item_user_groups" model="ir.rule">
        <field name="name">Dashboard items: back-end access groups</field>
        <field name="model_id" ref="model_axs_dashboard_item"/>
        <field name="domain_force">['|', ('dashboard_id.group_ids', '=', False), ('dashboard_id.group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_user'))]"/>
    </record>

    <record id="rule_dashboard_item_manager_all" model="ir.rule">
        <field name="name">Dashboard items: managers see all</field>
        <field name="model_id" ref="model_axs_dashboard_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_dashboard_manager'))]"/>
    </record>
</odoo>
